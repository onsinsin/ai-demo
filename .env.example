# ===== 大模型 DeepSeek（apps/agent/.env）=====
DEEPSEEK_API_KEY=sk-xxxx

# ===== 高德 Web 服务 key（apps/agent/.env，Agent 会注入给 geocode-mcp 子进程）=====
# 需开通「Web 服务」类型；用于地名地址检索（place/text、geocode/geo）
AMAP_KEY=xxxx

# ===== Mapbox access token（apps/web/.env，前端底图 + mapbox-gl）=====
VITE_MAPBOX_ACCESS_TOKEN=pk.xxxx

# ===== CopilotKit -> LangGraph 服务地址（apps/server/.env，默认无需改）=====
LANGGRAPH_URL=http://localhost:8123

# ===== 可选：自研 MCP 入口覆盖（默认由 apps/agent 内自动推算）=====
# GEOCODE_MCP_ENTRY=/abs/path/packages/geocode-mcp/dist/index.js
